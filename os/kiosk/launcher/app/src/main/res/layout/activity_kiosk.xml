<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:contentDescription="@string/logo_descripcion"
        android:src="@drawable/ic_launcher" />

    <TextView
        android:id="@+id/state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:letterSpacing="0.08"
        android:textColor="@color/texto"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="DIAGNOSTRUCT" />

    <TextView
        android:id="@+id/state_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:maxWidth="520dp"
        android:textColor="@color/texto_tenue"
        android:textSize="16sp"
        tools:text="Abriendo la aplicacion…" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:indeterminateTint="@color/marca" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minWidth="220dp"
        android:minHeight="56dp"
        android:text="@string/accion_reintentar"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_technician"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/accion_panel_tecnico"
        android:visibility="gone" />

</LinearLayout>
