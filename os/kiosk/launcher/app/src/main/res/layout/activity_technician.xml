<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.12"
            android:text="@string/tecnico_titulo"
            android:textColor="@color/texto"
            android:textSize="21sp" />

        <!-- Estado bloqueado: solo se pide el PIN -->
        <LinearLayout
            android:id="@+id/locked_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tecnico_pin_etiqueta"
                android:textColor="@color/texto_tenue"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/pin_input"
                style="@style/Campo"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:autofillHints="password"
                android:background="@drawable/campo_linea"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:letterSpacing="0.35"
                android:maxLength="12"
                android:paddingVertical="10dp"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_unlock"
                style="@style/Boton.Acento"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_entrar"
                app:icon="@drawable/ic_entrar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_cancel"
                style="@style/Boton.Plano"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_cancelar"
                app:icon="@drawable/ic_cancelar" />
        </LinearLayout>

        <!-- Estado desbloqueado: acciones de mantenimiento -->
        <LinearLayout
            android:id="@+id/unlocked_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_open_app"
                style="@style/Boton.Lista.Acento"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/tecnico_abrir_app"
                app:icon="@drawable/ic_volver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_wifi"
                style="@style/Boton.Lista"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_wifi"
                app:icon="@drawable/ic_wifi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_update"
                style="@style/Boton.Lista"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_actualizar"
                app:icon="@drawable/ic_actualizar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_reapply"
                style="@style/Boton.Lista"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_reaplicar"
                app:icon="@drawable/ic_politica" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_toggle_kiosk"
                style="@style/Boton.Lista"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_entrar_mantenimiento"
                app:icon="@drawable/ic_mantenimiento" />

            <!-- Cambio del PIN de mantenimiento -->
            <TextView
                android:id="@+id/pin_warning"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/tecnico_pin_por_defecto"
                android:textColor="@color/acento"
                android:textSize="13sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/new_pin_input"
                style="@style/Campo"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:background="@drawable/campo_linea"
                android:hint="@string/tecnico_pin_nuevo"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="12"
                android:paddingVertical="10dp"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_change_pin"
                style="@style/Boton.Lista"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:text="@string/tecnico_cambiar_pin"
                app:icon="@drawable/ic_pin" />

            <TextView
                android:id="@+id/diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@color/superficie"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.4"
                android:padding="18dp"
                android:textColor="@color/texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
