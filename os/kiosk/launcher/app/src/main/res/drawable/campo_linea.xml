<?xml version="1.0" encoding="utf-8"?>
<!--
  Campo de texto reducido a una linea inferior. Los bordes laterales y superior
  se desplazan fuera del area visible, que es la forma de quedarse solo con la
  base sin dibujar una caja.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/linea" />
        </shape>
    </item>
</layer-list>
