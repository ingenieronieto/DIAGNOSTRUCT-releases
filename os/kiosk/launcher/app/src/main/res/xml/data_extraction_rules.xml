<?xml version="1.0" encoding="utf-8"?>
<!--
  La configuracion del kiosco (incluido el PIN de mantenimiento) no debe salir
  del equipo ni viajar a otro en una transferencia.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
