<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DiagnostructOs" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/acento</item>
        <item name="colorOnPrimary">@color/texto</item>
        <item name="colorSurface">@color/fondo</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
    </style>

    <!-- Pantalla de inicio: a pantalla completa y sin animacion de entrada. -->
    <style name="Theme.DiagnostructOs.Kiosk">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!--
      Botones de trazo, sin relleno. En una pantalla que el tecnico ve tres
      segundos, un boton macizo de color pesa mas de lo que aporta: basta el
      contorno para que se lea como pulsable.
    -->
    <style name="Boton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/linea</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="rippleColor">@color/linea</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/texto_tenue</item>
    </style>

    <!-- La accion principal de cada pantalla, y solo esa, lleva el azul. -->
    <style name="Boton.Acento">
        <item name="strokeColor">@color/acento</item>
        <item name="android:textColor">@color/acento</item>
        <item name="iconTint">@color/acento</item>
    </style>

    <!--
      Las acciones del panel se leen como una lista, no como botones sueltos:
      icono y texto alineados a la izquierda, para poder recorrerlas de un
      vistazo en lugar de leer cinco etiquetas centradas.
    -->
    <style name="Boton.Lista">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">16dp</item>
    </style>

    <style name="Boton.Lista.Acento">
        <item name="strokeColor">@color/acento</item>
        <item name="android:textColor">@color/acento</item>
        <item name="iconTint">@color/acento</item>
    </style>

    <!-- Acciones secundarias: sin contorno, para que no compitan. -->
    <style name="Boton.Plano" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/texto_tenue</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/linea</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/texto_tenue</item>
    </style>

    <style name="Campo">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_tenue</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
